<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 replaced the launch screen. From API 31 the platform ignores
      windowBackground for the splash and composes its own: a background colour
      with the launcher icon centred on it. That is why setting
      launch_background alone changed nothing on a modern phone, and why the
      icon appeared as a black square — ic_launcher carries an opaque dark
      background of its own, which looked deliberate on a dark ground and like
      a mistake on a light one.

      splash_logo is the transparent mark, so it sits on the themed ground
      instead of bringing its own.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/lamp_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
